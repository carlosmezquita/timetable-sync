[Unit]
Description=Timetable to Outlook reconciliation
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=timetable-sync
Group=timetable-sync
WorkingDirectory=/opt/timetable-sync/current
EnvironmentFile=/etc/timetable-sync.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/timetable-sync/current/.venv/bin/timetable-sync sync --apply --summary
TimeoutStartSec=240
MemoryMax=192M
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/timetable-sync
